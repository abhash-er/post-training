# MareNostrum 5 (BSC) environment for post-training TRL-in-container workflows.
# Sourced on the login node by submit.py (HF cache vars) and inside the SLURM
# job script before the container launches (so --export=ALL carries these in).
#
# Override any variable at the command line or edit this file for your run.

# ── Container image (x86 PyTorch base + overlay venv on PATH) ────────────────
export CONTAINER=/gpfs/scratch/ehpc532/eit234648/post-training/containers/torch-base.sif

# ── Hugging Face cache (on scratch, inside a bind mount) ─────────────────────
export HF_HOME=/gpfs/scratch/ehpc532/eit234648/.hf_cache
export TRANSFORMERS_CACHE=$HF_HOME
export HF_HUB_CACHE=$HF_HOME/hub
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export HF_DATASETS_CACHE=$HF_HOME/datasets

# Offline is controlled by the YAML (offline: true) / train.py, not here.

# ── MN5 compiler fix ────────────────────────────────────────────────────────
# MN5's Intel modules leak CC=icc, which breaks torch.compile (Inductor) and any
# source build inside the container. The job purges modules (module_purge: true),
# but force gcc as belt-and-suspenders.
export CC=gcc
export CXX=g++

# ── Bind-mount roots (reference; actual binds set in the YAML) ───────────────
export SCRATCH_DIR=/gpfs/scratch/ehpc532/eit234648
export MODELS_DIR=/gpfs/scratch/ehpc532/models

export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export GPUS_PER_NODE=4
